#!/bin/sh
# Safety net, not a lock (git hooks can be skipped). Enable once per clone (it covers every worktree):
#   git config core.hooksPath .githooks
# Refuses: any push to main; deleting or force-updating a wave/ or lane/ branch.
# Override for a deliberate, Lukas-approved action: CREATORSTUDIO_ALLOW_PUSH_OVERRIDE=1 git push ...
zero=0000000000000000000000000000000000000000
[ "${CREATORSTUDIO_ALLOW_PUSH_OVERRIDE:-}" = "1" ] && exit 0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      echo "pre-push: refusing to push to ${remote_ref#refs/heads/}; open a pull request instead." >&2
      exit 1 ;;
    refs/heads/wave/*|refs/heads/lane/*)
      if [ "$local_sha" = "$zero" ]; then
        echo "pre-push: refusing to delete $remote_ref." >&2
        exit 1
      fi
      if [ "$remote_sha" != "$zero" ] && ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
        echo "pre-push: refusing a non-fast-forward update of $remote_ref." >&2
        exit 1
      fi ;;
  esac
done
exit 0
